# Copy to .env. Never put real keys in source code or screenshots.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
# Comma-separated IDs shown in the model picker. Every model needs tool support;
# Computer mode additionally needs image input support.
OPENROUTER_MODELS=openai/gpt-6.1-sol,openai/gpt-3.5-turbo
MAX_ROUNDS=24
TURN_TIMEOUT_SECONDS=180
# Absolute binary path works on both macOS and Windows.
CUA_DRIVER_COMMAND=cua-driver
